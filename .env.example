# Copy to .env and fill in. Never commit .env!

# Discord bot token (Developer Portal -> Bot -> Reset Token)
DISCORD_TOKEN=

# Optional: your Discord server id. Slash commands appear instantly instead of after up to 1h.
GUILD_ID=

# SeAT instance and API token (SeAT -> API Tokens)
SEAT_URL=https://seat.example.com
SEAT_TOKEN=

# Your corporation id
CORP_ID=
# Characters whose notifications are read (Director / Station Manager), comma separated
NOTIFY_CHAR_IDS=

# Who collects the moon tax (used in the pop announcement jokes)
TAX_COLLECTOR=The tax collector

# Host user/group that owns ./data (run `id` on the server: uid=... gid=...)
PUID=1000
PGID=1000

# Intervals in minutes
STATUS_INTERVAL_MIN=60
NOTIF_INTERVAL_MIN=10
# Pops older than this (hours) never get pinged, e.g. after downtime of the bot
PING_MAX_AGE_H=6
